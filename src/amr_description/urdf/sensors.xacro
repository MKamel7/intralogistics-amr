<?xml version="1.0"?>
<!-- Sensor links and their Gazebo Harmonic definitions.

     Every sensor parameter comes from the platform spec, which traces it to an
     archived data sheet. Where a sheet is ambiguous that is stated here rather
     than resolved by picking whichever reading flatters the result. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Sensor topics are prefixed with the robot namespace. This is not
       cosmetic: Gazebo honours an explicit <topic>, so without the prefix every
       robot in a fleet publishes onto the SAME topic and the scans interleave
       with no error anywhere. Caught by the multi-robot benchmark. -->

  <!-- ============ safety laser scanner ============
       Reference part: SICK nanoScan3. 275 degree aperture, 0.17 degree angular
       resolution, 3 m protective field, 10 m warning field, 40 m measuring
       range, 70 ms response time.

       The scan rate is one over the response time rather than a number chosen
       for convenience: a protective device cannot report faster than it
       responds, and overstating it would flatter every stopping-distance
       result downstream. -->
  <xacro:macro name="safety_scanner" params="name rx ry yaw">
    <!-- The link origin is the OPTICAL CENTRE, not the centre of the housing.
         That distinction is the whole reason this mount works.

         A safety scanner recessed inboard of the vehicle's corner cannot see
         tangentially along the vehicle's own sides: a ray from an inboard
         position towards the far corner re-enters the chassis before it clears
         the body. That is structural, not a tuning error, and it measured as a
         contiguous 11.6 degree blind sector in the merged scan.

         Sitting flush at the corner, the optics graze both adjacent faces and
         see roughly the outward half plane. Two of them on opposite corners
         then cover the full turn, which is what the platform claims. The
         housing is drawn inboard so the physical body still sits in the recess
         and inside the published envelope. -->
    <link name="${name}_link">
      <xacro:box_inertia m="${p['scanner_mass']}" x="${p['scanner_body_x']}" y="${p['scanner_body_y']}" z="${p['scanner_body_z']}"/>
      <visual>
        <origin xyz="${-p['scanner_housing_inset']} 0 0"/>
        <geometry><box size="${p['scanner_body_x']} ${p['scanner_body_y']} ${p['scanner_body_z']}"/></geometry>
        <material name="amr_sensor"/>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${rx * p['scanner_mount_x']} ${ry * p['scanner_mount_y']}
                   ${p['scanner_mount_height']}"
              rpy="0 0 ${yaw}"/>
    </joint>

    <gazebo reference="${name}_link">
      <material>Gazebo/Grey</material>
      <sensor name="${name}" type="gpu_lidar">
        <topic>${ns}${name}/scan</topic>
        <update_rate>${p['scanner_update_rate']}</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
        <gz_frame_id>${name}_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>${p['scanner_samples']}</samples>
              <resolution>1</resolution>
              <min_angle>${-radians(p['scanner_scan_angle']) / 2.0}</min_angle>
              <max_angle>${radians(p['scanner_scan_angle']) / 2.0}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>${p['scanner_measuring_range']}</max>
            <!-- Range quantisation matched to the detection resolution the
                 scanner is configured for. -->
            <resolution>${p['scanner_detection_resolution']}</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- ============ RGB-D camera ============
       Reference part: Intel RealSense D435, as named by the platform sheet.

       RESOLVED. The platform sheet gives 114 degrees horizontal under a heading
       covering TWO cameras, without saying whether that is per camera or
       combined. The archived Intel sheet settles it: one D435 sees 87 degrees
       +/- 3. So 114 is the COMBINED figure, and modelling each camera at 114
       overstated it by 27 degrees, which is what the earlier note warned about.

       Each camera is now 87 degrees, toed out by 13.5 degrees, and the pair
       spans exactly the 114 degrees the platform sheet publishes. The two
       sheets agree, which is a real cross-check rather than an assumption. -->
  <xacro:macro name="rgbd_camera" params="name y yaw">
    <link name="${name}_link">
      <xacro:box_inertia m="${p['camera_mass']}" x="${p['camera_body_x']}" y="${p['camera_body_y']}" z="${p['camera_body_z']}"/>
      <visual>
        <geometry><box size="${p['camera_body_x']} ${p['camera_body_y']} ${p['camera_body_z']}"/></geometry>
        <material name="amr_sensor"/>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${p['chassis_length'] / 2.0 - 0.015} ${y} ${p['camera_mount_height']}"
              rpy="0 0 ${yaw}"/>
    </joint>

    <!-- Optical frame: REP 103 puts camera optical axes as z forward, x right,
         y down, which is not the robot convention, so the two are kept as
         separate frames rather than silently mixed.

         IT IS DEFINED BUT IT IS NOT WHAT THE POINT CLOUD IS STAMPED WITH, and
         the difference cost a full debugging round. Gazebo Harmonic publishes
         the rgbd_camera point cloud in the camera's LINK convention, x forward,
         y left, z up, not in the optical convention. Stamping it as the optical
         frame makes every consumer apply a 90 degree rotation the data has
         already accounted for.

         Measured on the running system: labelled optical, 41.8 percent of the
         cloud landed BELOW THE FLOOR, which is impossible, and 17173 points
         landed inside the vehicle's own footprint, so the costmap marked the
         vehicle as standing in an obstacle and the planner answered
         "Start occupied" while the vehicle sat in an aisle with 3.05 m of
         clearance. Labelled as the link frame, both counts are exactly zero.

         The frame is kept because it is correct for IMAGE geometry, and if
         anything ever reprojects the colour or depth image it will need it.
         Nothing does today, and the point cloud is what navigation consumes. -->
    <link name="${name}_optical_frame"/>
    <joint name="${name}_optical_joint" type="fixed">
      <parent link="${name}_link"/>
      <child link="${name}_optical_frame"/>
      <origin rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <gazebo reference="${name}_link">
      <sensor name="${name}" type="rgbd_camera">
        <topic>${ns}${name}</topic>
        <update_rate>${p['camera_update_rate']}</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
        <!-- The LINK frame, deliberately. See the note above the optical
             frame definition: the cloud is already in this convention. -->
        <gz_frame_id>${name}_link</gz_frame_id>
        <camera>
          <horizontal_fov>${radians(p['camera_hfov'])}</horizontal_fov>
          <image>
            <!-- 320x240, and this is a CPU budget decision rather than a
                 sensor limit. See docs/adr/0003-three-tier-simulation.md.
                 
                 It was 640x480. Each frame is then 307200 points, two cameras
                 produce 3.7 million points per second, and every one of them
                 is serialised by the bridge and inserted into a voxel layer on
                 two costmaps. Measured with that setting: bridge at 72 percent
                 of a core, controller at 84 percent, load average 35 on 12
                 cores, and the MPPI control loop falling from its required
                 20 Hz to between 8 and 19 Hz until the behaviour tree gave up
                 waiting with "Failed to get result for follow_path".

                 320x240 is a quarter of the data and loses nothing that
                 matters: across an 87 degree field, 320 columns put samples
                 about 24 mm apart at the 4 m marking range, still finer than
                 the 50 mm costmap cell they are being written into. Sampling a
                 grid four times more finely than its resolution is not extra
                 information, it is extra cost. -->
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <!-- Clip planes are the SENSOR's limits, not a convenient framing.
               Min-Z 0.105 m and about 10 m maximum range, both from the Intel
               sheet. The platform sheet's 0.25 m is the minimum distance at
               which the camera sees the GROUND, which is a mounting geometry
               figure and a different quantity. -->
          <clip>
            <near>${p['camera_min_depth']}</near>
            <far>${p['camera_max_range']}</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- ============ IMU ============ -->
  <xacro:macro name="imu_sensor" params="name">
    <link name="${name}_link">
      <xacro:box_inertia m="${p['imu_mass']}" x="0.02" y="0.02" z="0.01"/>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="0 0 ${p['ground_clearance'] + 0.02}"/>
    </joint>

    <gazebo reference="${name}_link">
      <sensor name="${name}" type="imu">
        <topic>${ns}${name}</topic>
        <update_rate>100</update_rate>
        <always_on>1</always_on>
        <gz_frame_id>${name}_link</gz_frame_id>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- ============ optional 3D lidar ============
       NOT part of the reference platform. Off by default so the robot stays
       what the data sheet describes; enabled only for the overhang and voxel
       mapping experiments, and labelled as an addition wherever it is used. -->
  <xacro:macro name="lidar_3d" params="name">
    <link name="${name}_link">
      <xacro:box_inertia m="0.5" x="0.09" y="0.09" z="0.07"/>
      <visual>
        <geometry><cylinder radius="0.045" length="0.07"/></geometry>
        <material name="amr_sensor"/>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="0 0 ${p['chassis_height'] + 0.05}"/>
    </joint>

    <gazebo reference="${name}_link">
      <sensor name="${name}" type="gpu_lidar">
        <topic>${ns}${name}/points</topic>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
        <gz_frame_id>${name}_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>512</samples>
              <resolution>1</resolution>
              <min_angle>${-pi}</min_angle>
              <max_angle>${pi}</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>${radians(-15)}</min_angle>
              <max_angle>${radians(15)}</max_angle>
            </vertical>
          </scan>
          <range><min>0.1</min><max>30.0</max><resolution>0.01</resolution></range>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>
