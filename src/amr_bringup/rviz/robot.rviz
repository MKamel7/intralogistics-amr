Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: [/Global Options1, /RobotModel1, /Safety scanners1]
    Tree Height: 700
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 0.75
      Color Scheme: map
      Draw Behind: true
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Color: 90; 90; 96
      Alpha: 0.4
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Alpha: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Marker Scale: 0.4
    - Class: rviz_default_plugins/LaserScan
      Name: Merged scan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Size (m): 0.03
      Style: Points
      Color: 245; 145; 30
      Color Transformer: FlatColor
      Decay Time: 0
    - Class: rviz_default_plugins/LaserScan
      Name: Safety scanner rear
      Enabled: true
      Topic:
        Value: /scanner_rear_right/scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Size (m): 0.03
      Style: Points
      Color: 80; 170; 245
      Color Transformer: FlatColor
      Decay Time: 0
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: false
      Topic:
        Value: /diff_drive_controller/odom
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Keep: 100
      Shape:
        Alpha: 0.6
        Shaft Length: 0.3
        Head Length: 0.1
  Global Options:
    Background Color: 38; 40; 44
    Fixed Frame: odom
    Frame Rate: 20
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 6
      Pitch: 0.6
      Yaw: 2.4
      Focal Point: {X: 0, Y: 0, Z: 0}
      Target Frame: base_link
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
  Displays: {collapsed: false}
