<?xml version="1.0"?>
<package format="3">
  <name>amr_perception</name>
  <version>0.1.0</version>
  <description>
    Perception for the MiR250-class AMR. Scan conditioning and merge today;
    human detection, tracking and prediction to follow. The hot paths are C++
    because they run per frame on a 15 W CPU; see docs/adr/0004.
  </description>
  <maintainer email="mkamel860@gmail.com">Mohamed Kamel</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_cpplint</test_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
