<?xml version="1.0"?>
<!-- A pedestrian, modelled as rigid geometry rather than an animated actor.

     WHY NOT AN ACTOR. Gazebo actors are animated skeletons that live outside
     the physics engine, and whether a lidar returns hits on one is version
     dependent. The whole perception phase depends on people being detectable,
     so this uses ordinary model geometry, which is unambiguously rendered and
     therefore unambiguously visible to a gpu_lidar. The cost is that the legs
     do not swing; the benefit is that nothing downstream rests on an assumption
     about actor rendering.

     WHY THE COLLISION AND THE VISUAL DIFFER. A gpu_lidar renders VISUAL
     geometry. So the visuals are two legs and a torso, which is what the
     scanner should see and what gives a leg-pair signature at scan height. The
     collision is a single short cylinder at the floor: a human balanced on two
     thin cylinders topples immediately in a physics engine, and a fallen
     pedestrian is not the test case. The puck keeps it upright while the
     scanner still sees legs.

     DIMENSIONS are ordinary adult anthropometry, not a data sheet. They are
     estimates and are labelled as such; if a published detection figure ever
     depends on them, EN ISO 7250 or DIN 33402-2 should be archived first and
     the numbers taken from there. -->
<sdf version="1.10">
  <model name="person">
    <link name="body">
      <inertial>
        <pose>0 0 0.95 0 0 0</pose>
        <mass>75.0</mass>
        <inertia>
          <ixx>12.0</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>12.0</iyy><iyz>0</iyz>
          <izz>1.2</izz>
        </inertia>
      </inertial>

      <!-- Stability puck. Short, wide and low, so the model stays upright. -->
      <collision name="base">
        <pose>0 0 0.12 0 0 0</pose>
        <geometry><cylinder><radius>0.22</radius><length>0.24</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
        </surface>
      </collision>

      <!-- What the scanner sees. The scan plane is at 150 mm, so it cuts the
           legs and nothing else, which is the signature the detector keys on:
           two small round clusters about 200 mm apart. -->
      <visual name="leg_left">
        <pose>0 0.10 0.42 0 0 0</pose>
        <geometry><cylinder><radius>0.055</radius><length>0.84</length></cylinder></geometry>
        <material>
          <ambient>0.15 0.18 0.28 1</ambient>
          <diffuse>0.20 0.24 0.36 1</diffuse>
        </material>
      </visual>
      <visual name="leg_right">
        <pose>0 -0.10 0.42 0 0 0</pose>
        <geometry><cylinder><radius>0.055</radius><length>0.84</length></cylinder></geometry>
        <material>
          <ambient>0.15 0.18 0.28 1</ambient>
          <diffuse>0.20 0.24 0.36 1</diffuse>
        </material>
      </visual>
      <visual name="torso">
        <pose>0 0 1.15 0 0 0</pose>
        <geometry><box>
          <size>0.24 0.45 0.62</size>
        </box></geometry>
        <material>
          <ambient>0.55 0.30 0.10 1</ambient>
          <diffuse>0.85 0.45 0.15 1</diffuse>
        </material>
      </visual>
      <visual name="head">
        <pose>0 0 1.58 0 0 0</pose>
        <geometry><sphere><radius>0.11</radius></sphere></geometry>
        <material>
          <ambient>0.45 0.35 0.30 1</ambient>
          <diffuse>0.70 0.55 0.45 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Driven by publishing a twist on /model/<name>/cmd_vel. Left here rather
         than in the world so every pedestrian gets it automatically. -->
    <plugin filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl"/>
  </model>
</sdf>
