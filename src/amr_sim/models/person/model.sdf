<?xml version="1.0"?>
<!-- A pedestrian, driven along a rail rather than pushed around by physics.

     WHY THE CENTRE OF MASS IS LOW. The figure is a free body driven by the
     velocity plugin. It first carried a real person's inertia, 75 kg with its
     centre of mass at 0.95 m, over a collision puck of radius 0.22 m. That tips
     at about 13 degrees of lean, so the pedestrians fell over, climbed the
     racking and ended up hovering at z = 0.27 m with nothing beneath them.

     The centre of mass now sits inside the collision body at 0.12 m and the
     tensor is that cylinder's, so it cannot tip. The visuals are unchanged: the
     scanner still sees legs at scan height and a torso above them. Only the
     dynamics changed, and they now match the body that actually touches the
     floor.

     A prismatic rail welded to the world was tried and abandoned: a model
     joined to `world` is treated as fixed and its joints do not articulate at
     all, verified by commanding the joint directly in Gazebo and seeing no
     motion.

     WHY NOT AN ACTOR. Gazebo actors are animated skeletons outside the physics
     engine and whether a lidar returns hits on one is version dependent. Rigid
     geometry is unambiguously rendered and therefore unambiguously visible,
     which is the property the whole perception phase rests on.

     DIMENSIONS are ordinary adult anthropometry, not a data sheet, and are
     labelled estimates. If a published detection figure ever depends on them,
     EN ISO 7250 or DIN 33402-2 should be archived first. -->
<sdf version="1.10">
  <model name="person">

    <link name="body">
      <!-- Inertia of the puck that touches nothing, since the rail carries the
           figure. Kept plausible rather than arbitrary. -->
      <inertial>
        <pose>0 0 0.12 0 0 0</pose>
        <mass>75.0</mass>
        <inertia>
          <ixx>1.267</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1.267</iyy><iyz>0</iyz>
          <izz>1.815</izz>
        </inertia>
      </inertial>

      <!-- What the scanner sees. The scan plane is at 150 mm, so it cuts the
           legs and nothing else, which is the leg-pair signature the detector
           keys on: two small round clusters about 200 mm apart. -->
      <visual name="leg_left">
        <pose>0 0.10 0.42 0 0 0</pose>
        <geometry><cylinder><radius>0.055</radius><length>0.84</length></cylinder></geometry>
        <material>
          <ambient>0.15 0.18 0.28 1</ambient>
          <diffuse>0.20 0.24 0.36 1</diffuse>
        </material>
      </visual>
      <visual name="leg_right">
        <pose>0 -0.10 0.42 0 0 0</pose>
        <geometry><cylinder><radius>0.055</radius><length>0.84</length></cylinder></geometry>
        <material>
          <ambient>0.15 0.18 0.28 1</ambient>
          <diffuse>0.20 0.24 0.36 1</diffuse>
        </material>
      </visual>
      <visual name="torso">
        <pose>0 0 1.15 0 0 0</pose>
        <geometry><box><size>0.24 0.42 0.62</size></box></geometry>
        <material>
          <ambient>0.55 0.30 0.10 1</ambient>
          <diffuse>0.90 0.48 0.12 1</diffuse>
        </material>
      </visual>
      <visual name="arm_left">
        <pose>0 0.27 1.12 0 0 0</pose>
        <geometry><cylinder><radius>0.048</radius><length>0.60</length></cylinder></geometry>
        <material>
          <ambient>0.55 0.30 0.10 1</ambient>
          <diffuse>0.90 0.48 0.12 1</diffuse>
        </material>
      </visual>
      <visual name="arm_right">
        <pose>0 -0.27 1.12 0 0 0</pose>
        <geometry><cylinder><radius>0.048</radius><length>0.60</length></cylinder></geometry>
        <material>
          <ambient>0.55 0.30 0.10 1</ambient>
          <diffuse>0.90 0.48 0.12 1</diffuse>
        </material>
      </visual>
      <visual name="hi_vis_band">
        <pose>0 0 1.30 0 0 0</pose>
        <geometry><box><size>0.25 0.43 0.09</size></box></geometry>
        <material>
          <ambient>0.75 0.75 0.75 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
        </material>
      </visual>
      <visual name="head">
        <pose>0 0 1.58 0 0 0</pose>
        <geometry><sphere><radius>0.11</radius></sphere></geometry>
        <material>
          <ambient>0.45 0.35 0.30 1</ambient>
          <diffuse>0.70 0.55 0.45 1</diffuse>
        </material>
      </visual>

      <!-- A slim collision so the figure is a real obstacle to anything that
           touches it, without a wide puck that could catch on scenery. -->
      <collision name="body_collision">
        <pose>0 0 0.60 0 0 0</pose>
        <geometry><cylinder><radius>0.18</radius><length>1.20</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>0.2</mu><mu2>0.2</mu2></ode></friction>
        </surface>
      </collision>
    </link>

    <!-- Driven by publishing a twist on /model/<name>/cmd_vel. -->
    <plugin filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl"/>
  </model>
</sdf>
