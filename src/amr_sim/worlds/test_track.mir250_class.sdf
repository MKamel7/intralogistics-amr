<?xml version="1.0"?>
<!-- Generated by amr_sim/tools/generate_test_track.py from
     amr_description/config/platforms/mir250_class.yaml.
     Do not hand-edit: change the spec or the generator.
     
     Zone widths and where each number comes from:
       aisle_1    2.502 m   derived: turning width + 0.70 m to pass a person + 0.30 m
       aisle_2    2.202 m   derived: turning width + 0.70 m to pass a person
       pinch      2.302 m   derived: turning width + 0.70 m to pass a person + 0.10 m
       cross      2.402 m   derived: turning width + 0.70 m to pass a person + 0.20 m, a junction
       doorway    2.202 m   derived: turning width + 0.70 m to pass a person, straight through
       open_bay   2.300 m   measured: AWS p75, V-22
       claim: corridor_default 1.350 m   published, NOT tested here
       claim: corridor_dynamic 1.000 m   published, NOT MET, V-26
       claim: corner_90 0.950 m   published, NOT MET, V-27
       claim: doorway 1.300 m   published, NOT tested here
-->
<sdf version="1.10">
  <!-- THE WORLD NAME MUST EQUAL THE FILE STEM. Gazebo topics are built from
       the world's INTERNAL name, and the launch derives them from the FILE
       name, so the two disagreeing means every /world/<name>/... topic is
       wrong. It was "test_track" in a file called test_track.<platform>.sdf,
       so the ground truth pose feed subscribed to a topic that did not exist:
       no poses reached the pedestrian driver and not one walker ever moved.
       Nothing errored, because subscribing to a topic nobody publishes is a
       legal thing to do. warehouse.sdf gets this right by having a one word
       name. -->
  <world name="test_track.mir250_class">

    <physics name="default" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.78 0.82 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
      <cast_shadows>false</cast_shadows>
    </light>

